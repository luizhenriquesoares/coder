# CodeR configuration. Copy this file to `.env` and fill in what you need.
# With nothing set, CodeR runs in demo mode: three sample pull requests and a
# scripted council, no network access and no cost.

# ── Claude: the real council ───────────────────────────────────────────────
# One credential for the Claude API is enough. With more than one set, CodeR
# uses the first in the order below and warns about it when it starts. The
# login of a Claude plan (Claude Code's own, or `claude setup-token`) is not
# one of them: CodeR's usage is billed to a Claude Console organization. Keep
# every value here out of chats and commits. Paste a key or a token alone, on
# one line: CodeR does not start on one with a space, a quote or a line break.
#
# 0. The auth token below, kept in AWS Systems Manager Parameter Store: the
#    name or ARN of its parameter, such as /coder/anthropic-auth-token. CodeR
#    reads it when it starts, with the AWS credentials of this machine (the
#    AWS CLI's profile, single sign-on, or the role it runs under), which
#    need ssm:GetParameter on it. The region is the ARN's, else AWS_REGION.
ANTHROPIC_AUTH_TOKEN_SSM_PARAMETER=
# AWS_REGION=eu-west-1
# 1. An auth token, sent as `Authorization: Bearer`. Either the token of your
#    LLM gateway, with ANTHROPIC_BASE_URL below, or an access token of your
#    Console sign-in: `ant auth print-credentials --env` prints this line.
#    That token is short-lived; to stay signed in, use the profile instead.
ANTHROPIC_AUTH_TOKEN=
# 2. Your Console sign-in on this machine: no key, and nothing to paste. Run
#    `ant auth login` once and name its profile here (`default` unless you
#    chose another). CodeR renews the token by itself until the sign-in runs
#    out, some weeks later. Set it in this file rather than with `export`:
#    Claude Code reads the same variable and would move to that sign-in.
ANTHROPIC_PROFILE=
# 3. An API key from https://platform.claude.com/settings/keys. The one to use
#    on a server: a sign-in belongs to a person and stays on their machine.
ANTHROPIC_API_KEY=
#    Or the name or ARN of the parameter of AWS Systems Manager that holds it,
#    read like the token's above.
ANTHROPIC_API_KEY_SSM_PARAMETER=
# Only for a gateway or another API host. The reviews go there, and so does
# the renewal of a sign-in unless its own settings name another address. A
# sign-in never travels over plain http to another machine.
ANTHROPIC_BASE_URL=
# Model for every seat of the council, and how hard it thinks (low | medium | high | xhigh | max).
CODER_MODEL=claude-opus-5-5
CODER_EFFORT=high
# Upper bound for one reviewer's answer, thinking included.
CODER_MAX_OUTPUT_TOKENS=32000

# ── GitHub ─────────────────────────────────────────────────────────────────
# A fine-grained personal access token with "Pull requests: Read and write" and
# "Contents: Read-only" on the repositories below. Without a token CodeR can
# still read public pull requests, but cannot publish reviews.
GITHUB_TOKEN=
# Repositories whose open pull requests appear in the inbox: owner/repo, comma separated.
GITHUB_REPOSITORIES=
# Only for GitHub Enterprise Server, e.g. https://github.example.com/api/v3
GITHUB_API_URL=

# ── Automatic review ───────────────────────────────────────────────────────
# true: the council reviews every new commit of every open, non-draft pull
# request in GITHUB_REPOSITORIES, found by polling. Each review costs API usage.
AUTO_REVIEW=false
POLL_INTERVAL_SECONDS=30
# Alternative to polling: point a GitHub webhook (event "Pull requests",
# content type application/json) at POST /api/webhooks/github with this secret.
GITHUB_WEBHOOK_SECRET=

# ── Server ─────────────────────────────────────────────────────────────────
PORT=4317
# CodeR listens on this machine only and, without a token, only answers
# requests made on it. To expose it, set HOST (for example 0.0.0.0) and a token
# of at least 16 characters: the server refuses to start on another address
# without one, and every API call must then send `Authorization: Bearer <token>`.
HOST=127.0.0.1
CODER_API_TOKEN=
# Language the council writes in for automatic reviews: en | pt
CODER_LANGUAGE=en
# Name recorded next to accept/dismiss decisions.
CODER_REVIEWER=human
# Show the three sample pull requests and the scripted council.
CODER_DEMO=true
# Where review sessions are stored (one event log per session).
CODER_DATA_DIR=.data
